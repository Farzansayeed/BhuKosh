# --- BhuKosh environment (SIH26018) ---
# Copy to .env and fill in. .env is gitignored; never commit real values.

APP_NAME=BhuKosh
ENV=dev
HOST=127.0.0.1
PORT=8000

# Postgres — set DATABASE_URL for hosted Postgres (Supabase/Neon); it overrides PG_* below
# Example (Supabase session pooler): postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Postgres (portable local instance) — underscored names match pydantic-settings fields
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=bhukosh
PG_USER=bhukosh
PG_PASSWORD=CHANGE_ME_LOCAL_ONLY
PGDATA_DIR=./infra/pgdata
PGBIN=./infra/pg16/pgsql/bin

# Auth
JWT_SECRET=CHANGE_ME_generate_with_backend/scripts/gen_secret.py
JWT_ALG=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Extraction engine (Mode A / demo fixtures) — engine swap = config change (plan §12)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# /extract per-user rate limit (sliding window over successful calls)
EXTRACT_RATE_LIMIT_PER_MIN=5
EXTRACT_RATE_WINDOW_SECONDS=60

# Second extraction engine (Groq - OpenAI-compatible, Llama vision)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Third engine (OpenRouter - one key, many free models; minimax-m3:free won the live bake-off on a real Gujarati scan)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free

# Groq free tier is now TEXT-ONLY (no vision models). Model must be a current text model:
# GROQ_MODEL=qwen/qwen3.8-27b  (see GET /models on your Groq account for the live list)
